---
// Project cover inside a browser frame. Shows a branded placeholder when there is no image
// or the image fails to load, so a missing upload never leaves a broken box.
interface Props { src?: string; title: string; platform?: string; eager?: boolean }
const { src, title, platform, eager = false } = Astro.props;
---
<div class="frame">
  <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="cover">
    <div class="cover-ph" aria-hidden={src ? 'true' : undefined}>
      {platform && <span>{platform}</span>}
      <b>{title}</b>
    </div>
    {src && (
      <img
        src={src}
        alt={`Screenshot of the ${title} website`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        onerror="this.remove()"
      />
    )}
  </div>
</div>
