---
import Logo from './Logo.astro';
import settings from '../data/settings.json';
const path = Astro.url.pathname;
const links = [
  { href: '/#services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.href === '/work' && path.startsWith('/work') ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-primary" href={settings.calendlyUrl} target="_blank" rel="noopener">Book a call</a>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <div class="menu-panel">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a class="btn btn-primary" href={settings.calendlyUrl} target="_blank" rel="noopener">Book a call</a>
      </div>
    </details>
  </div>
</header>
<script>
  // Close the mobile menu after a link is tapped.
  document.querySelectorAll('.menu-panel a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
  );
</script>
