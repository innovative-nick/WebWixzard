---
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wordmark" data-reveal>WebWix<span>z</span>ard</div>
  <div class="f-cols">
    <div data-reveal>
      <h3>Quick Links</h3>
      <ul>
        <li><a href="/#home">Home</a></li>
        <li><a href="/#services">About Us</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/get-started">Start your Project</a></li>
        <li><a href={settings.calendlyUrl} target="_blank" rel="noopener">Book a Free Consultation</a></li>
      </ul>
    </div>
    <dl class="f-contact" data-reveal style="--d:.1s">
      <h3>Contact</h3>
      <dt>Email:</dt>
      <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
      <dt>Phone</dt>
      <dd><a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a></dd>
    </dl>
  </div>
  <p class="copy">Copyrights {year} | Webwixzard™ | <a href="/terms">Terms &amp; Conditions</a></p>
</footer>
