---
import Logo from './Logo.astro';
import settings from '../data/settings.json';

const icons: Record<string, string> = {
  facebook: 'M14 8.5V6.8c0-.8.5-1 1-1h2V2.2h-2.8C11.1 2.2 10.4 4.5 10.4 6v2.5H8.5V12h1.9v9.8H14V12h2.6l.4-3.5z',
  instagram: 'M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 3.6c2.7 0 3 0 4.1.1 2.8.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.8-.1-4-1.4-4.1-4.1-.1-1.1-.1-1.4-.1-4.1s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.1 4.1-.1z',
  linkedin: 'M6.9 21H3.2V9h3.7v12zM5 7.4a2.1 2.1 0 1 1 0-4.3 2.1 2.1 0 0 1 0 4.3zM21 21h-3.7v-5.8c0-1.4 0-3.2-2-3.2s-2.2 1.5-2.2 3.1V21H9.4V9h3.5v1.6h.1c.5-.9 1.7-2 3.5-2 3.8 0 4.5 2.5 4.5 5.7V21z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z',
  tiktok: 'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.2v12.4a2.6 2.6 0 1 1-1.8-2.5V9.6a5.8 5.8 0 1 0 5 5.8V9.1a7.4 7.4 0 0 0 4.3 1.4V7.3a4.3 4.3 0 0 1-3.2-1.5z',
  whatsapp: 'M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 5 5.1-1.3A9.8 9.8 0 1 0 12 2.2zm5.7 13.9c-.2.7-1.4 1.3-2 1.3-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.8-.7 13.6 13.6 0 0 1-5.1-4.6c-.4-.5-1.2-1.6-1.2-3s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.3c.1.2.1.4 0 .6l-.3.5-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.3 1.1 2.3 1.5 2.6 1.6.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2.2 1c.3.2.5.2.6.4.1.1.1.7-.2 1.4z',
};
const socials = (['facebook', 'instagram', 'linkedin', 'youtube', 'tiktok', 'whatsapp'] as const)
  .filter((k) => (settings as Record<string, string>)[k])
  .map((k) => ({ key: k, href: (settings as Record<string, string>)[k], path: icons[k] }));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo />
        <p>Websites, AI chatbots and automation for businesses that want to look as good online as they are in person. White-label builds for agencies.</p>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.key}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
              </a>
            ))}
          </div>
        )}
      </div>
      <div>
        <h4>Quick links</h4>
        <ul>
          <li><a href="/#services">Services</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href={settings.calendlyUrl} target="_blank" rel="noopener">Start your project</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          {settings.phone && <li><a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a></li>}
          <li><a href={settings.calendlyUrl} target="_blank" rel="noopener">Book a free call</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>© {year} WebWixzard™. All rights reserved.</span>
      <span>Designed and built by WebWixzard.</span>
    </div>
  </div>
</footer>
