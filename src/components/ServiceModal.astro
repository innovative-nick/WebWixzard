---
interface Props { id: string; icon: string; title: string; text: string; items: string[]; bullet?: 'round' | 'square'; cta: string }
const { id, icon, title, text, items, bullet = 'round', cta } = Astro.props;
---
<dialog class="modal" id={id} aria-labelledby={`${id}-title`}>
  <button class="modal-close" type="button" aria-label="Close" data-close>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#1a1a1a" stroke="#fff" stroke-width="2"/><path d="M8.5 8.5l7 7m0-7l-7 7" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
  </button>
  <div class="modal-body">
    <img src={icon} alt="" width="60" height="60" />
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{text}</p>
    <h3>What's covered:</h3>
    <ul class={`covered ${bullet}`}>{items.map((i) => <li>{i}</li>)}</ul>
    <a class="btn btn-orange modal-btn" href={cta} target="_blank" rel="noopener">Book a Free Consultation</a>
  </div>
</dialog>
