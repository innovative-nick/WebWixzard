---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import ServiceModal from '../components/ServiceModal.astro';
import settings from '../data/settings.json';
import pricing from '../data/pricing.json';
import testimonials from '../data/testimonials.json';
import faqs from '../data/faqs.json';
import logos from '../data/logos.json';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const cal = settings.calendlyUrl;
const tel = settings.phone.replace(/\s/g, '');
const strip = [...logos, ...logos];
---
<Base>
  <!-- Hero -->
  <header class="hero" id="home">
    <Nav />
    <div class="hero-body">
      <div class="hero-copy">
        <h1 data-reveal>We build websites that <br class="br" />make businesses look <br class="br" /><span class="accent">exactly as good</span> as they are.</h1>
        <p class="hero-sub" data-reveal style="--d:.12s">Your website is the first thing potential clients see. We make sure it builds trust, communicates your value, and turns visitors into leads, starting from day one.</p>
        <div class="hero-btns" data-reveal style="--d:.24s">
          <a class="btn btn-orange" href={cal} target="_blank" rel="noopener">Book a Free Consultation</a>
          <a class="btn btn-outline" href="/get-started">Start My Project <Icon name="arrow-circle" /></a>
        </div>
      </div>
    </div>
  </header>

  <!-- Client logos -->
  {logos.length > 0 && (
    <section class="logos" aria-label="Clients we've worked with">
      <div class="logos-track">
        {strip.map((l, i) => <img src={l.image} alt={i < logos.length ? l.name : ''} aria-hidden={i >= logos.length ? 'true' : undefined} loading="lazy" />)}
      </div>
    </section>
  )}

  <!-- What we do -->
  <section class="services" id="services">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="eyebrow">What we do</span>
        <h2>Focused on what <span class="accent">actually moves</span> the needle</h2>
        <p class="lead">We don't do everything. We do two things exceptionally well, premium websites and smart AI tools, so your business can grow without the guesswork.</p>
      </div>
      <div class="cards">
        <article class="card" data-reveal>
          <img src="/images/icon-web.jpg" alt="" loading="lazy" />
          <h3>Website Design &amp; Redesign</h3>
          <p>From new builds to full redesigns — we handle everything website. Strategy, design, copy, development, and launch. You get a site that looks great, loads fast, and turns visitors into paying clients.</p>
          <button class="learn" type="button" data-modal="modal-web">Learn More <Icon name="arrow-circle" /></button>
        </article>
        <article class="card" data-reveal style="--d:.12s">
          <img src="/images/icon-ai.jpg" alt="" loading="lazy" />
          <h3>AI Integration</h3>
          <p>We plug intelligent automation into your business so it runs smarter around the clock. Chatbots that convert, voice agents that respond, and workflows that handle the repetitive — so you don't have to.</p>
          <button class="learn" type="button" data-modal="modal-ai">Learn More <Icon name="arrow-circle" /></button>
        </article>
      </div>
    </div>
  </section>

  <ServiceModal
    id="modal-web"
    icon="/images/icon-web.jpg"
    title="Web Design"
    text="From new builds to full redesigns, we handle everything website. Strategy, design, copy, development, and launch. You get a site that looks great, loads fast, and turns visitors into paying clients."
    items={['New website design & development', 'Website redesigns & refreshes', 'Landing pages & sales pages', 'Copywriting & content setup', 'SEO foundation & speed optimization', 'Mobile-first, fully responsive']}
    bullet="round"
    cta="/get-started"
  />
  <ServiceModal
    id="modal-ai"
    icon="/images/icon-ai.jpg"
    title="AI Integration"
    text="We plug intelligent automation into your business so it runs smarter around the clock. Chatbots that convert, voice agents that respond, and workflows that handle the repetitive — so you don't have to."
    items={['AI chatbots for websites & WhatsApp', 'Voice agents & phone automation', 'Lead capture & qualification bots', 'Business workflow automation', 'CRM & booking integrations', 'Custom AI tools for your workflow']}
    bullet="square"
    cta="/get-started"
  />

  <!-- How we work -->
  <section class="process" id="process">
    <div class="wrap center-head" data-reveal>
      <span class="eyebrow">How we work</span>
      <h2>A process built for clarity <span class="amp">&amp;</span> speed</h2>
      <p>We don't do everything. We do two things exceptionally well, premium websites and smart AI tools, so your business can grow without the guesswork.</p>
    </div>
    <div class="steps">
      <div class="step" data-reveal>
        <span class="num">01</span>
        <h3>Discover</h3>
        <p>We start with a quick call to understand your business, your goals, and what’s not working. No tech talk — just clarity.</p>
      </div>
      <div class="step" data-reveal style="--d:.1s">
        <span class="num">02</span>
        <h3>Design <span class="amp" style="font-family:var(--head);font-weight:600">&amp;</span> Build</h3>
        <p>We turn your vision into a custom, high-converting website with smart features, clear messaging, and bold design.</p>
      </div>
      <div class="step" data-reveal style="--d:.2s">
        <span class="num">03</span>
        <h3>Launch <span class="amp" style="font-family:var(--head);font-weight:600">&amp;</span> Grow</h3>
        <p>Once your site is live, we make sure everything runs smoothly and give you the tools and support to keep growing with confidence.</p>
      </div>
      <div class="steps-foot">
        <a class="btn btn-orange solid" href={cal} target="_blank" rel="noopener">Book a Free Consultation</a>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="portfolio" id="portfolio">
    <div class="wrap">
      <div data-reveal>
        <h2>Portfolio</h2>
        <p class="sub">A glimpse into Some of the websites we’ve designed and built.</p>
      </div>
      <div class="grid">
        {projects.map((p, i) => (
          <a class="shot" href={p.data.liveUrl || '#portfolio'} target={p.data.liveUrl ? '_blank' : undefined} rel="noopener" data-reveal style={`--d:${(i % 2) * 0.1}s`}>
            <div class="img">{p.data.cover && <img src={p.data.cover} alt={`${p.data.title} website`} loading="lazy" />}</div>
            <span>Click to view live website</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cta cta-outer">
    <div class="cta-box" data-reveal>
      <div>
        <h2>They searched. They found you. They left.</h2>
        <p>Start your project before it happens again.</p>
      </div>
      <a class="btn btn-orange" href="/get-started">Start my Project</a>
    </div>
  </section>
  <hr class="rule" />

  <!-- Pricing -->
  <section class="pricing" id="pricing">
    <div class="wrap center-head" data-reveal>
      <span class="eyebrow">Pricing</span>
      <h2>Transparent pricing. <em>No surprises.</em></h2>
      <p>Every project is different — but you deserve to know what to expect. Pick the package that fits where your business is right now.</p>
    </div>
    <div class="plans">
      {pricing.map((plan, i) => (
        <article class={`plan${plan.popular ? ' popular' : ''}`} data-reveal style={`--d:${i * 0.1}s`}>
          {plan.popular && <span class="tag">Most Popular</span>}
          <h3>{plan.name}</h3>
          <p class="summary">{plan.summary}</p>
          <div class="price"><sup>$</sup>{plan.price}</div>
          <p class="price-note">{plan.note}</p>
          <ul class="feats">{plan.features.map((f) => <li>{f}</li>)}</ul>
          <a class="btn btn-plan" href="/get-started">Get Started</a>
        </article>
      ))}
    </div>
    <div data-reveal>
      <p class="plans-note">Not sure which plan fits or need something more specific?<br />Book a free call and we'll scope it out together — honestly.</p>
      <div class="plans-cta"><a class="btn btn-orange solid" href={cal} target="_blank" rel="noopener">Book a Free Consultation</a></div>
    </div>
  </section>
  <hr class="rule" />

  <!-- Testimonials -->
  <section class="testimonials" id="testimonials">
    <div class="wrap center-head" data-reveal>
      <span class="eyebrow">Testimonials</span>
      <h2>What our clients<br />actually say</h2>
    </div>
    <div class="wrap">
      <div class="quotes">
        {testimonials.map((t, i) => (
          <figure class="quote" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
            <blockquote class="clamp">{t.quote}</blockquote>
            <button class="read-more" type="button">Read more</button>
            <figcaption class="who"><b>{t.name}</b><span>{[t.role, t.company].filter(Boolean).join(', ')}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap">
      <div class="side" data-reveal>
        <span class="eyebrow" style="text-transform:lowercase">faq</span>
        <h2>Questions we hear often</h2>
        <p>Can't find what you're looking for? Reach out directly, we usually reply within a few hours.</p>
      </div>
      <div class="acc" data-reveal style="--d:.1s">
        {faqs.map((f) => (
          <details>
            <summary>{f.question}<Icon name="chevron" /></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="wrap">
      <div data-reveal>
        <h2>Contact Us</h2>
        <div class="c-list">
          <div class="c-item">
            <small><Icon name="mail" /> Email</small>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </div>
          <div class="c-item">
            <small><Icon name="phone" /> Phone</small>
            <a href={`tel:${tel}`}>{settings.phone}</a>
          </div>
          {(settings.instagram || settings.linkedin) && (
            <div class="c-item">
              <small>Socials</small>
              <div class="socials">
                {settings.instagram && <a href={settings.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
                {settings.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>}
              </div>
            </div>
          )}
        </div>
      </div>
      <div class="book" data-reveal style="--d:.12s">
        <div class="book-inner">
          <h2>Claim Your Free Consultation</h2>
          <img src="/images/consultation.jpg" alt="Calendar with dates marked for a consultation" loading="lazy" />
          <a class="btn btn-orange" href={cal} target="_blank" rel="noopener">Book Your Free Call</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Testimonial "Read more": only show when the quote is cut off.
  document.querySelectorAll('.quote').forEach(function (q) {
    var text = q.querySelector('blockquote'), b = q.querySelector('.read-more');
    b.addEventListener('click', function () {
      var clamped = text.classList.toggle('clamp');
      b.textContent = clamped ? 'Read more' : 'Read less';
    });
  });
</script>
