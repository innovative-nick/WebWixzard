---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page-hero" style="min-height:60vh;display:grid;align-items:center">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This page has <em>moved or vanished.</em></h1>
      <p>The link may be old. Head back to the homepage or see our latest work.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/">Go to homepage</a><a class="btn btn-ghost" href="/work">See our work</a></div>
    </div>
  </section>
</Base>
