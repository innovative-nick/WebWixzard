---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="contact" style="padding:140px 0 120px;text-align:center">
    <div class="wrap" style="display:grid;justify-items:center;gap:18px">
      <span class="eyebrow">404</span>
      <h2 style="font-size:48px">This page doesn't exist.</h2>
      <p>The link may be old. Head back to the homepage.</p>
      <a class="btn btn-orange solid" href="/">Go to homepage</a>
    </div>
  </section>
</Base>
